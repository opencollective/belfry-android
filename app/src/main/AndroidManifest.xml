<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: asked in the app when it explains why (Me → Notifications), never at launch -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- "Scan an invitation": asked when the scanner opens. A device without a camera installs too. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Audio recording (＋ → Audio recording): the microphone is asked when a recording starts. It
         goes on with the screen off in a foreground service of type "microphone". -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- The app updates itself (Me → Updates, the bar in Home): the system's installer asks the
         person to confirm, and installs it only when it is signed with the same key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".BelfryApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Belfry">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Sign-in comes back here: sh.belfry.app://connect?code=…&state=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sh.belfry.app" android:host="connect" />
            </intent-filter>
            <!--
              Guest links: https://chat.<domain>/join/<token> open in the app (Android App Links).
              One entry per community; a manifest placeholder cannot hold a list, so the hosts
              are written out. Add a line for another community's domain. A host only opens the
              app without asking once it serves /.well-known/assetlinks.json naming this app
              (see SERVER-NEEDS.md); until then the link opens in the browser.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="chat.belfry.sh" />
                <data android:host="chat.enspiral.eu" />
                <data android:pathPrefix="/join/" />
                <!-- An event's address (the belfry redirects it to the web chat's #/events/<link>) -->
                <data android:pathPrefix="/events/" />
            </intent-filter>
        </activity>

        <!-- Push (FCM data-only messages, decrypted and posted by the app). Without Firebase in the
             build it is never started. -->
        <service
            android:name=".push.BelfryMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Keeps a recording going with the screen off (Pause / Resume / Stop in its notification). -->
        <!-- The system installer's answers for a self-update (update/Updater.kt). -->
        <receiver
            android:name=".update.UpdateReceiver"
            android:exported="false" />

        <service
            android:name=".rec.RecordingService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>
</manifest>
