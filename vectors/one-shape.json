 "threadState": {
  "about": "An e-mail thread's state. labels = the belfry/inbox status labels (kind 1985, l = open | answered | closed) on its first card. Base = the newest label's value (ties by id ascending: the higher id wins), open when there is none. Then: if the newest received e-mail (created_at) is newer than the newest answered-or-closed label, the thread is open again. Computed by every reader; no event. A sent reply card (kind 9 by the groups key, client belfry-mail-out; `sent` here, its created_at) counts as an `answered` label at its time (vectors/mailthreads.json: threads answered before 0.8.0 have no label). `sent` absent = none.",
  "cases": [
   {
    "name": "no label",
    "received": [
     100
    ],
    "labels": [],
    "expect": "open"
   },
   {
    "name": "answered",
    "received": [
     100
    ],
    "labels": [
     {
      "id": "l1",
      "created_at": 150,
      "l": "answered"
     }
    ],
    "expect": "answered"
   },
   {
    "name": "the sender wrote again",
    "received": [
     100,
     200
    ],
    "labels": [
     {
      "id": "l1",
      "created_at": 150,
      "l": "answered"
     }
    ],
    "expect": "open"
   },
   {
    "name": "closed then new mail",
    "received": [
     100,
     300
    ],
    "labels": [
     {
      "id": "l1",
      "created_at": 150,
      "l": "closed"
     }
    ],
    "expect": "open"
   },
   {
    "name": "reopened by hand then answered",
    "received": [
     100
    ],
    "labels": [
     {
      "id": "l1",
      "created_at": 150,
      "l": "closed"
     },
     {
      "id": "l2",
      "created_at": 160,
      "l": "open"
     },
     {
      "id": "l3",
      "created_at": 170,
      "l": "answered"
     }
    ],
    "expect": "answered"
   },
   {
    "name": "same second as the mail stays answered",
    "received": [
     150
    ],
    "labels": [
     {
      "id": "l1",
      "created_at": 150,
      "l": "answered"
     }
    ],
    "expect": "answered"
   },
   {
    "name": "a sent card with no label = answered",
    "received": [
     100
    ],
    "sent": [
     150
    ],
    "labels": [],
    "expect": "answered"
   },
   {
    "name": "a sent card, then the sender wrote again",
    "received": [
     100,
     200
    ],
    "sent": [
     150
    ],
    "labels": [],
    "expect": "open"
   }
  ]
 },
 "drafts": {
  "about": "Internal drafts: kind 1111 on the thread's first card with [\"mail-draft\",\"1\"]. Shown unless a sent card (kind 9 by the groups key, client belfry-mail-out) carries [\"draft\", its id], or its author deleted it (kind 5 with [\"e\", id] by the same author). Edits (1010) by its author change the text, not this rule.",
  "cases": [
   {
    "name": "one sent, one deleted, one kept",
