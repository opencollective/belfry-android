      "pubkey": "ana",
      "e": "d3"
     }
    ],
    "expect": [
     "d3",
     "d4"
    ]
   }
  ]
 },
 "due": {
  "about": "To-do due date: [\"due\", \"<unix seconds>\"] on the kind 2100; the author's newest kind 1010 edit replaces the tags (its tags win when it carries a due; an edit without a due tag clears it). Not a positive integer: no due date.",
  "cases": [
   {
    "name": "set",
