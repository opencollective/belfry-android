 "pins": {
  "about": "Reading pins. Everyone's: the \"pinned\" array in the content of the newest kind 30078 d=belfry:channel-order by a belfry admin. Mine: the newest kind 30078 d=belfry:pins by me, its content NIP-44 v2 to myself; here `plain` is the decrypted content. Content {\"v\":1,\"c\":[ids]}: bad JSON or no array gives []; entries that are not strings or not in `known` are skipped; duplicates keep the first. Writing mine: {\"v\":1,\"c\":[...]} with the channel added at the end or removed; a writer of channel-order keeps every other key.",
  "cases": [
   {
    "name": "mine, newest wins",
    "known": [
     "a",
     "b",
     "c"
    ],
    "copies": [
     {
      "created_at": 100,
      "plain": "{\"v\":1,\"c\":[\"a\"]}"
     },
     {
      "created_at": 200,
      "plain": "{\"v\":1,\"c\":[\"b\",\"zz\",3,\"b\",\"c\"]}"
     }
    ],
    "expect": [
     "b",
     "c"
    ]
   },
   {
    "name": "bad json",
    "known": [
     "a"
    ],
    "copies": [
     {
      "created_at": 100,
      "plain": "not json"
     }
    ],
    "expect": []
   },
   {
    "name": "no c",
    "known": [
     "a"
    ],
    "copies": [
     {
      "created_at": 100,
      "plain": "{\"v\":1}"
     }
    ],
    "expect": []
   },
   {
    "name": "everyone's from channel-order",
    "known": [
     "general",
     "hello"
    ],
    "channelOrder": "{\"order\":[\"general\",\"hello\"],\"categories\":[],\"pinned\":[\"hello\",\"gone\",\"general\"]}",
    "expect": [
     "hello",
     "general"
    ]
   },
   {
    "name": "toggle on then off",
    "start": [
     "a"
    ],
    "toggle": [
     "b",
     "a"
    ],
    "expectContent": "{\"v\":1,\"c\":[\"b\"]}"
   }
  ]
 },
